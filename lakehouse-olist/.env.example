# ===========================================================================
# lakehouse-olist — variáveis de ambiente
# Copie para .env (make setup faz isso automaticamente) e ajuste se preciso.
# ===========================================================================

# --- MinIO (S3 local para desenvolvimento) --------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Credenciais S3 usadas pelo Spark/dbt (apontam para MinIO localmente) --
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
# Endpoint do MinIO. Em produção AWS, deixe vazio para usar o S3 real.
AWS_ENDPOINT_URL=http://minio:9000

# --- Camadas do lakehouse (buckets) ---------------------------------------
BRONZE_BUCKET=lakehouse-bronze
SILVER_BUCKET=lakehouse-silver
GOLD_BUCKET=lakehouse-gold
RAW_BUCKET=lakehouse-raw

# --- Caminhos de dados -----------------------------------------------------
# Local onde os CSVs do Olist são montados dentro do container Spark.
RAW_DATA_PATH=/opt/app/data/raw
# Prefixo base das tabelas Delta (s3a://<bucket> em prod, file:// para teste).
DELTA_BASE_PATH=s3a://lakehouse-bronze

# --- Spark -----------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
DELTA_LOG_RETENTION=interval 30 days

# --- Postgres (metastore / Airflow) ---------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- dbt -------------------------------------------------------------------
DBT_SPARK_HOST=spark-master
DBT_SPARK_PORT=10000
DBT_SCHEMA=lakehouse
